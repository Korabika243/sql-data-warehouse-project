create view gold.dim_customers as 
select row_number() over(order by ci.cst_id)as customer_key,  
ci.cst_id as customer_id,ci.cst_key as customer_number,concat(ci.cst_firstname,' ',ci.cst_lastname)customer_name,la.CNTRY as country,
ci.cst_marital_status as marital_status,
case when ci.cst_gndr!='n/a' then ci.cst_gndr
else coalesce(ca.GEN,'n/a')
end gndr,ca.BDATE as birthdate,ci.cst_create_date as create_date
from silver.crm_cus_inf as ci

left join silver.erp_CUST_AZ12 as ca
on ci.cst_key=ca.CID
left join silver.erp_LOC_A101 as la
on ci.cst_key=la.CID
